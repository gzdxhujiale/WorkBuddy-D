# ============================================================
# WorkBuddy-D 生产打包环境变量 (.env.production)
# 由 pnpm build / pnpm run "tauri build" 自动编译入产物
# ============================================================

# 生产环境 Go 后端 API 地址 (Render + 自定义二级域名)
VITE_API_BASE_URL=https://workbuddy.hujiale.works

# 生产环境 Go 后端 WebSocket 实时同步长连接
VITE_WS_URL=wss://workbuddy.hujiale.works/ws
