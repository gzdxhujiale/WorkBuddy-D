# ============================================================
# WorkBuddy-D 环境变量模板 (复制为 .env 使用)
# ============================================================

# ----------------- Go 后端服务配置 -----------------
PORT=8080
JWT_SECRET=workbuddy-desktop-default-jwt-secret-key-prod
CORS_ORIGIN=*

# 数据库连接串 (DB_DSN)
# 1. 连接云端 Neon (推荐个人开发使用，单一事实源，免本地 Docker 容器开销):
# DB_DSN="postgresql://[user]:[password]@[endpoint].neon.tech/workbuddy?sslmode=require"
#
# 2. 连接本地 Docker Postgres (离线开发回退，默认本地开发端口):
DB_DSN="postgres://postgres:postgres@localhost:5432/workbuddy?sslmode=disable"

# ----------------- 前端配置 -----------------
# 前端连接的 Go 后端 API 地址与 WebSocket 长连接
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
